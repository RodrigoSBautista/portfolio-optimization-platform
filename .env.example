# Copy this file to `.env` (gitignored) and set real values locally.
# Phase 1 runs on local SQLite by default, so no real secrets are required yet.

# SQLAlchemy database URL.
#   Phase 1 (local default): sqlite:///portfolio.db
#   Production (later):       postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///portfolio.db

# Secret for signing auth sessions (generate a random value locally; used later).
AUTH_SECRET=change-me-locally
